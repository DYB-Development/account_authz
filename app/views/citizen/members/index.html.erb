<%= ui_page(max_width: :lg) do %>
  <%= ui_section(title: "Members") do %>
    <% @members.each do |member| %>
      <% held = member.citizen_roles.in_account(Citizen::Current.account_id).to_a %>
      <%= ui_panel do %>
        <%= ui_section(title: member.name, subtitle: member.email, spacing: :sm) do %>
          <% if held.any? %>
            <div>
              <% held.each do |role| %>
                <%= ui_badge(label: role.name, variant: :info) %>
              <% end %>
            </div>
          <% end %>
          <% if @reach.includes_member?(member) %>
            <%= ui_grid(cols: { default: 2, sm: 3 }, gap: :sm) do %>
              <% (held & @roles).each do |role| %>
                <%= ui_form(action: member_role_path(member, role), method: :delete) do %>
                  <%= ui_button(label: "Take #{role.name}", variant: :danger, size: :sm) %>
                <% end %>
              <% end %>
              <% (@roles - held).each do |role| %>
                <%= ui_form(action: member_roles_path(member)) do %>
                  <%= hidden_field_tag :role_id, role.id, id: nil %>
                  <%= ui_button(label: "Give #{role.name}", variant: :secondary, size: :sm) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
